APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:3000
DINGTALK_MODE=mock
DINGTALK_CLIENT_ID=local-development-client
DINGTALK_CLIENT_SECRET=local-development-secret
# Required in http mode. Copy the numeric AgentId from the DingTalk app credentials page.
DINGTALK_CORP_ID=replace-with-corp-id
DINGTALK_AGENT_ID=
DINGTALK_API_BASE_URL=https://api.dingtalk.com
DINGTALK_LEGACY_API_BASE_URL=https://oapi.dingtalk.com
# Keep link for the verified default. Set interactive_card only after publishing and testing a card template.
DINGTALK_NOTIFICATION_CHANNEL=link
DINGTALK_CARD_TEMPLATE_ID=
# Optional; defaults to DINGTALK_CLIENT_ID (the app clientId/robotCode).
DINGTALK_CARD_ROBOT_CODE=
SALARY_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# In production this must be an absolute path outside the deployed release directory.
SALARY_DATABASE_PATH=./data/salary-slip.sqlite
# Production requires a unique random value of at least 16 characters.
SESSION_SIGNING_KEY=local-development-session-signing-key
PORT=3000
